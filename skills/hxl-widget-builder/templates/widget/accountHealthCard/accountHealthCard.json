{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": { "gap": "md" },
          "children": [
            {
              "definition": "tile/row",
              "attributes": { "gap": "sm", "justify": "between", "align": "center" },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "xs" },
                  "children": [
                    { "definition": "tile/text", "attributes": { "text": "{!$attrs.accountName}", "variant": "h2" } },
                    { "definition": "tile/text", "attributes": { "text": "{!$attrs.industry}", "variant": "caption", "color": "muted" } }
                  ]
                },
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.statusLabel}",
                    "variant": "{!$attrs.statusVariant}"
                  }
                }
              ]
            },
            {
              "definition": "tile/callout",
              "meta": { "if": "{!$attrs.isAtRisk}" },
              "attributes": { "variant": "warning", "title": "Needs attention", "description": "{!$attrs.riskReason}" }
            },
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "sm" },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": { "justify": "between" },
                      "children": [
                        { "definition": "tile/text", "attributes": { "text": "Annual revenue", "variant": "body", "weight": "semibold" } },
                        { "definition": "tile/text", "attributes": { "text": "{!$attrs.annualRevenueLabel}", "variant": "body" } }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": { "justify": "between" },
                      "children": [
                        { "definition": "tile/text", "attributes": { "text": "Open cases", "variant": "body", "weight": "semibold" } },
                        { "definition": "tile/text", "attributes": { "text": "{!$attrs.openCaseCount}", "variant": "body" } }
                      ]
                    }
                  ]
                }
              ]
            },
            { "definition": "tile/text", "attributes": { "text": "Open opportunities", "variant": "h3" } },
            {
              "definition": "tile/row",
              "meta": { "forEach": "{!$attrs.openOpportunities}", "forItem": "$opp" },
              "attributes": { "gap": "sm", "justify": "between", "align": "center" },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "xs" },
                  "children": [
                    { "definition": "tile/text", "attributes": { "text": "{!$opp.name}", "variant": "body", "weight": "semibold" } },
                    { "definition": "tile/text", "attributes": { "text": "Closes {!$opp.closeDate}", "variant": "caption", "color": "muted" } }
                  ]
                },
                {
                  "definition": "tile/row",
                  "attributes": { "gap": "sm", "align": "center" },
                  "children": [
                    { "definition": "tile/badge", "attributes": { "label": "{!$opp.stageName}", "variant": "secondary" } },
                    { "definition": "tile/text", "attributes": { "text": "{!$opp.amountLabel}", "variant": "body" } }
                  ]
                }
              ]
            },
            { "definition": "tile/separator" },
            {
              "definition": "tile/row",
              "attributes": { "gap": "sm" },
              "children": [
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Suggest next steps",
                    "variant": "primary",
                    "actions": { "click": [ { "definition": "action/sendMessage", "attributes": { "content": "Suggest the three most important next steps for this account." } } ] }
                  }
                },
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Open in Salesforce",
                    "variant": "secondary",
                    "actions": { "click": [ { "definition": "action/openLink", "attributes": { "url": "{!$attrs.recordUrl}" } } ] }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
